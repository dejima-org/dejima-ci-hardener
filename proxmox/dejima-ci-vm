#!/usr/bin/env bash
# Build a sacrificial CI runner VM on a Proxmox node, firewall it, and
# snapshot it clean.
#
# Runs ON THE PROXMOX NODE, not in the VM and not on a dejima host. It needs
# qm and pvesh, which is why it lives here rather than being something the
# guest can do for itself - the firewall it installs is the one thing about
# this arrangement the guest must not be able to touch.
#
# What it does NOT do: install anything inside the VM. That is
# bin/dejima-ci-bootstrap, run once the VM is up. Two scripts because the
# boundary between them is the boundary that matters, and blurring it would
# invite putting the firewall somewhere the guest can reach.

set -euo pipefail

PROG=${0##*/}
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat >&2 <<EOF
Usage: $PROG --vmid N --role ci|runtime --ip CIDR --gateway IP \\
             --forge IP --resolver IP --mgmt IP [options]

Required:
  --vmid N            Proxmox VM id, unused
  --role ci|runtime   which tier this VM runs. runtime is the privileged one:
                      its jobs get the Docker socket and the host netns, so it
                      is the VM to treat as already lost
  --ip CIDR           static address for the VM, e.g. 192.0.2.60/24. Static
                      rather than DHCP: the firewall pins destinations, and a
                      lease that moves means rules that no longer describe it
  --gateway IP        default gateway
  --forge IP          the Gitea/Forgejo instance. One of two LAN pinholes
  --resolver IP       DNS server. The other
  --mgmt IP           the single host allowed to SSH in

Options:
  --name NAME         VM name (default dejima-<role>)
  --bridge BR         (default vmbr0)
  --storage STORE     (default local-lvm)
  --cores N           (default 4)
  --memory MB         (default 8192)
  --disk SIZE         (default 64G)
  --image PATH        Debian cloud image .qcow2. Downloaded if absent
  --sshkey PATH       public key for the admin user (default ~/.ssh/id_ed25519.pub)
  --no-snapshot       skip the post-build snapshot
  --dry-run           print what would run, change nothing
EOF
    exit 2
}

die() { echo "$PROG: $*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

VMID="" ROLE="" IPCIDR="" GATEWAY="" FORGE="" RESOLVER="" MGMT=""
NAME="" BRIDGE=vmbr0 STORAGE=local-lvm CORES=4 MEMORY=8192 DISK=64G
IMAGE="" SSHKEY="$HOME/.ssh/id_ed25519.pub" SNAPSHOT=1 DRYRUN=0

while [ $# -gt 0 ]; do
    case "$1" in
        --vmid) VMID="${2:?}"; shift ;;
        --role) ROLE="${2:?}"; shift ;;
        --ip) IPCIDR="${2:?}"; shift ;;
        --gateway) GATEWAY="${2:?}"; shift ;;
        --forge) FORGE="${2:?}"; shift ;;
        --resolver) RESOLVER="${2:?}"; shift ;;
        --mgmt) MGMT="${2:?}"; shift ;;
        --name) NAME="${2:?}"; shift ;;
        --bridge) BRIDGE="${2:?}"; shift ;;
        --storage) STORAGE="${2:?}"; shift ;;
        --cores) CORES="${2:?}"; shift ;;
        --memory) MEMORY="${2:?}"; shift ;;
        --disk) DISK="${2:?}"; shift ;;
        --image) IMAGE="${2:?}"; shift ;;
        --sshkey) SSHKEY="${2:?}"; shift ;;
        --no-snapshot) SNAPSHOT=0 ;;
        --dry-run) DRYRUN=1 ;;
        -h|--help) usage ;;
        *) die "unknown argument: $1" ;;
    esac
    shift
done

for req in VMID ROLE IPCIDR GATEWAY FORGE RESOLVER MGMT; do
    [ -n "${!req}" ] || { say "$PROG: --${req,,} is required"; usage; }
done
case "$ROLE" in ci|runtime) ;; *) die "--role must be ci or runtime" ;; esac
: "${NAME:=dejima-$ROLE}"

run() {
    if [ "$DRYRUN" -eq 1 ]; then printf '  would run: %s\n' "$*" >&2; return 0; fi
    "$@"
}

# Skipped under --dry-run so the rendered firewall can be reviewed from
# anywhere. Reviewing it is the point of the flag, and requiring the node to
# do that would mean the only way to read the rules before applying them is on
# the machine where applying them is one keystroke away.
if [ "$DRYRUN" -eq 0 ]; then
    command -v qm >/dev/null 2>&1 || die "qm not found - run this on the Proxmox node"
    [ -r "$SSHKEY" ] || die "no public key at $SSHKEY (--sshkey)"

    # Refuse rather than adopt: reusing an id whose VM someone else built
    # means inheriting whatever it already is, which for a box defined by what
    # it does NOT have is not a thing to guess at.
    if qm status "$VMID" >/dev/null 2>&1; then
        die "VM $VMID already exists - pick another id, or destroy it deliberately"
    fi
fi

# The datacenter-level switch. Without it a per-VM firewall file is read and
# enforced nowhere, which looks identical to it working - and this is the one
# component whose silent absence would leave the LAN open while everything
# reported success.
if [ "$DRYRUN" -eq 0 ] && command -v pvesh >/dev/null 2>&1; then
    dc_fw=$(pvesh get /cluster/firewall/options --output-format json 2>/dev/null || echo '{}')
    case "$dc_fw" in
        *'"enable":1'*|*'"enable": 1'*) : ;;
        *) say ""
           say "WARNING: the datacenter firewall appears to be disabled."
           say "A per-VM firewall file is read and enforced nowhere without it, and"
           say "nothing about that failure is visible from the VM. Enable it under"
           say "Datacenter -> Firewall -> Options -> Firewall: Yes, then re-check with"
           say "  pvesh get /cluster/firewall/options"
           say "" ;;
    esac
fi

# --- the image --------------------------------------------------------------
# A cloud image plus cloud-init rather than an ISO install: unattended, and it
# means rebuilding from scratch later is the same one command as building it
# now, which is what makes "rebuild rather than clean up" a real option.
IMG_URL="https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
if [ -z "$IMAGE" ]; then
    IMAGE="/var/lib/vz/template/iso/debian-12-genericcloud-amd64.qcow2"
    if [ ! -f "$IMAGE" ]; then
        say "Fetching the Debian cloud image..."
        run mkdir -p "$(dirname "$IMAGE")"
        run wget -q --show-progress -O "$IMAGE" "$IMG_URL" \
            || die "could not fetch $IMG_URL"
    fi
fi
[ "$DRYRUN" -eq 1 ] || [ -f "$IMAGE" ] || die "no image at $IMAGE"

# --- create -----------------------------------------------------------------
say "Creating VM $VMID ($NAME, role=$ROLE)..."
run qm create "$VMID" \
    --name "$NAME" \
    --cores "$CORES" --memory "$MEMORY" \
    --net0 "virtio,bridge=$BRIDGE,firewall=1" \
    --ostype l26 --agent enabled=1 \
    --scsihw virtio-scsi-single

run qm importdisk "$VMID" "$IMAGE" "$STORAGE" --format qcow2
run qm set "$VMID" --scsi0 "$STORAGE:vm-$VMID-disk-0,discard=on,ssd=1"
run qm disk resize "$VMID" scsi0 "$DISK"
run qm set "$VMID" --ide2 "$STORAGE:cloudinit" --boot order=scsi0 --serial0 socket --vga serial0

# Static addressing, because the firewall names this VM by address and a lease
# that moves is a rule that no longer describes it.
run qm set "$VMID" \
    --ipconfig0 "ip=$IPCIDR,gw=$GATEWAY" \
    --nameserver "$RESOLVER" \
    --ciuser dejima \
    --sshkeys "$SSHKEY"

# --- firewall ---------------------------------------------------------------
# Written before the first boot, so the VM has never once been on the network
# without it.
FW="/etc/pve/firewall/$VMID.fw"
say "Installing the VM firewall at $FW..."
rendered=$(sed \
    -e "s|__MGMT_IP__|$MGMT|g" \
    -e "s|__FORGE_IP__|$FORGE|g" \
    -e "s|__RESOLVER_IP__|$RESOLVER|g" \
    "$SRC/firewall.fw.template")
if [ "$DRYRUN" -eq 1 ]; then
    printf '  would write %s:\n' "$FW" >&2
    printf '%s\n' "$rendered" | sed 's/^/    /' >&2
else
    printf '%s\n' "$rendered" > "$FW"
fi

say "Starting VM $VMID..."
run qm start "$VMID"

if [ "$SNAPSHOT" -eq 1 ]; then
    say ""
    say "NOT snapshotting yet: a snapshot taken now captures a VM with nothing"
    say "installed. Run bin/dejima-ci-bootstrap inside it first, then take the"
    say "clean snapshot it tells you to."
fi

cat >&2 <<EOF

VM $VMID ($NAME) is up at ${IPCIDR%%/*}.

Next, inside the VM:

  ssh dejima@${IPCIDR%%/*}
  git clone https://gitbox.example.com/branderson/dejima-ci-hardener.git
  cd dejima-ci-hardener
  sudo ./bin/dejima-ci-bootstrap --role $ROLE

Then, back on this node, snapshot it clean:

  qm snapshot $VMID clean --description 'bootstrapped, before any job ran'

and roll back to that whenever you want it clean again:

  qm rollback $VMID clean

The firewall is at $FW and is enforced by this node, not by the VM. Check it
survived with:

  pve-firewall compile | grep -A20 "VM $VMID"

EOF
